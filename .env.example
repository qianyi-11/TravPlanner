# Server database. Production must be PostgreSQL.
DATABASE_URL=

# Auth.js server-only settings
AUTH_SECRET=
AUTH_URL=
AUTH_DEMO_ENABLED=false

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Browser-visible Google Maps JavaScript / Places API key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only Google Places API key
GOOGLE_PLACES_SERVER_API_KEY=

# Optional deployment/build label
NEXT_PUBLIC_APP_VERSION=
