generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id          String   @id
  name        String
  emoji       String
  coverColor  String
  description String?
  createdAt   DateTime @default(now())

  members GroupMember[]
  trips   Trip[]
  invites GroupInvite[]
}

/// A person, as a global identity — the same Member can belong to multiple
/// Groups (e.g. "you" are a member of every group you create or join).
model Member {
  id                      String   @id
  name                    String
  initials                String
  avatarColor             String
  isYou                   Boolean  @default(false)
  preferencesJson         String?
  /// Deprecated: kept for compatibility with existing databases; use TripMemberProgress.
  hasSubmittedSuggestions Boolean  @default(false)
  /// Deprecated: kept for compatibility with existing databases; use TripMemberProgress.
  hasSubmittedVotes       Boolean  @default(false)
  createdAt               DateTime @default(now())

  memberships GroupMember[]
  authIdentities AuthIdentity[]
  createdInvites GroupInvite[] @relation("MemberCreatedInvites")
  checklistItems TripChecklistItem[] @relation("ChecklistAssignee")
  tripMemberProgress TripMemberProgress[]
  suggestions Suggestion[]
  votes       Vote[]
}

model AuthIdentity {
  id                String   @id @default(cuid())
  memberId          String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([memberId])
}

/// Join table: which Members belong to which Group, and their role there.
model GroupMember {
  id       String @id @default(cuid())
  groupId  String
  memberId String
  role     String @default("member")

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

model Trip {
  id                    String   @id
  groupId               String
  name                  String
  destinationsJson      String
  coverColor            String
  startDate             String
  endDate               String
  budgetTotal           Int
  groupSize             Int
  dailyStart            String
  dailyEnd              String
  transport             String
  stage                 String   @default("ideas")
  shortlistJson         String   @default("[]")
  recommendedPlaceCount Int      @default(8)
  votesPerMember        Int      @default(10)
  itineraryJson         String   @default("[]")
  itineraryRevision     Int      @default(1)
  pricePressureJson     String
  splitBillJson         String?
  splitBillRevision     Int      @default(1)
  isLive                Boolean  @default(false)
  createdAt             DateTime @default(now())

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tripPlaces   TripPlace[]
  memberProgress TripMemberProgress[]
  checklistItems TripChecklistItem[]
  rescueEvents RescueEvent[]
}

model TripMemberProgress {
  id                   String   @id @default(cuid())
  tripId               String
  memberId             String
  submittedSuggestions Boolean  @default(false)
  submittedVotes       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripId, memberId])
  @@index([tripId])
  @@index([memberId])
}

model Place {
  id                       String   @id
  name                     String
  category                 String
  area                     String
  destination              String
  lat                      Float
  lng                      Float
  address                  String
  photo                    String
  rating                   Float
  reviewCount              Int
  priceLevel               Int
  priceLabel               String
  description              String
  openingHoursJson         String
  isOpenNow                Boolean
  closesAt                 String?
  estimatedDurationMinutes Int
  reviewsJson              String
  availability             String
  source                   String   @default("catalog") // "catalog" | "google"
  googlePlaceId            String?  @unique
  photoRef                 String?
  providerFetchedAt        DateTime?
  createdAt                DateTime @default(now())

  tripPlaces TripPlace[]
}

model GroupInvite {
  id                String   @id @default(cuid())
  groupId           String
  tokenHash         String   @unique
  createdByMemberId String
  createdAt         DateTime @default(now())
  revokedAt         DateTime?

  group           Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByMember Member @relation("MemberCreatedInvites", fields: [createdByMemberId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model TripPlace {
  id        String   @id @default(cuid())
  tripId    String
  placeId   String
  createdAt DateTime @default(now())

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place       Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  suggestions Suggestion[]
  votes       Vote[]

  @@unique([tripId, placeId])
}

model Suggestion {
  id          String   @id @default(cuid())
  tripPlaceId String
  memberId    String
  createdAt   DateTime @default(now())

  tripPlace TripPlace @relation(fields: [tripPlaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripPlaceId, memberId])
}

model Vote {
  id          String   @id @default(cuid())
  tripPlaceId String
  memberId    String
  createdAt   DateTime @default(now())

  tripPlace TripPlace @relation(fields: [tripPlaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripPlaceId, memberId])
}

model RescueEvent {
  id                 String   @id @default(cuid())
  tripId             String
  type               String
  message            String
  affectedActivityId String
  status             String   @default("open")
  alternativeJson    String?
  createdAt          DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripChecklistItem {
  id               String   @id
  tripId           String
  title            String
  assignedMemberId String?
  completed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip           Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignedMember Member? @relation("ChecklistAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([assignedMemberId])
}
