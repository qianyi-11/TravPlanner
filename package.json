{
  "name": "tp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:domain": "tsx --test lib/booking-pressure.test.ts lib/currency.test.ts lib/date-time.test.ts lib/geo.test.ts lib/google-places.test.ts lib/group-consensus.test.ts lib/itinerary-builder.test.ts lib/itinerary-validation.test.ts lib/place-cost.test.ts lib/place-duration.test.ts lib/place-facts.test.ts lib/plan-places.test.ts lib/rescue.test.ts lib/shortlist-capacity.test.ts lib/split-bill.test.ts lib/time-intervals.test.ts lib/utils.test.ts",
    "test:consensus": "tsx --test lib/group-consensus.test.ts lib/rescue.test.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "demo": "tsx scripts/run-demo.ts",
    "demo:record": "tsx scripts/run-demo.ts --record",
    "demo:browser-install": "playwright install chromium",
    "postinstall": "prisma generate",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate --schema=prisma/schema.sqlite.prisma",
    "db:generate:production": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js db push --schema=prisma/schema.sqlite.prisma",
    "db:push:production": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js db seed --schema=prisma/schema.sqlite.prisma",
    "db:seed:production": "prisma db seed --schema=prisma/schema.prisma",
    "db:migrate:production": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio --schema=prisma/schema.sqlite.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "prisma": "5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
